# Swipess Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to source control

# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Deployment Scripts
# Used by execution/deploy_edge_function.py
SUPABASE_PROJECT_REF="your-supabase-project-ref-id"
# SUPABASE_FUNCTION_SLUG="ai-orchestrator"  # optional, defaults to ai-orchestrator
# SUPABASE_FUNCTION_PATH="supabase/functions/ai-orchestrator/index.ts"  # optional

# Web Push (VAPID) Keys
# Generate with: node -e "const c=require('crypto');const {privateKey:pr,publicKey:pu}=c.generateKeyPairSync('ec',{namedCurve:'P-256',publicKeyEncoding:{type:'spki',format:'der'},privateKeyEncoding:{type:'sec1',format:'der'}});console.log('pub='+pu.subarray(27).toString('base64url'));console.log('priv='+pr.subarray(7,39).toString('base64url'));"
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# MiniMax AI API Key for Swipess Assistant
MINIMAX_API_KEY="your-minimax-api-key"

# Moonshot AI (Kimi) API Key
MOONSHOT_API_KEY="your-moonshot-api-key"

# Groq AI API Key (primary AI provider - super-fast inference)
GROQ_API_KEY="your-groq-api-key"

# --- Third-Party Integrations ---
# Mapbox (Global Passport live map + city search). On Vercel use EXACTLY this name:
# VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ...  (public token, not sk. secret)
# Also accepted: VITE_MAPBOX_TOKEN, MAPBOX_ACCESS_TOKEN. Redeploy after changing.
VITE_MAPBOX_ACCESS_TOKEN="your-mapbox-token"

# Google Maps / Places API (optional — enables worldwide city search in Global Passport)
# Enable "Maps JavaScript API" + "Places API" in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# --- Supabase Edge Functions (set in Supabase Dashboard → Edge Functions → Secrets) ---
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_ANON_KEY="your-anon-key"
# GEMINI_API_KEY="your-gemini-api-key"
# TAVILY_API_KEY="your-tavily-api-key"
# VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_SUBJECT="mailto:you@example.com"
# APPLE_SHARED_SECRET="your-apple-shared-secret"
# Sign in with Apple token revocation on account deletion (Guideline 5.1.1(v)):
# APPLE_TEAM_ID="your-apple-team-id"
# APPLE_KEY_ID="key-id-of-the-authkey-p8"
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_CLIENT_ID="com.swipess.mobile"   # optional, defaults to the bundle id
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# ALLOWED_ORIGIN="https://your-app.vercel.app"
# APP_ORIGIN="https://your-app.vercel.app"
