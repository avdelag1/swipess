  "name": "swipess",
  "private": true,
  "version": "1.2.7",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "description": "Elite multi-vertical marketplace for properties, vehicles, and services",
  "author": "Swipess Team",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/smoke-prod.mjs",
    "build:dev": "vite build --mode development",
    "postinstall": "node scripts/patch-capacitor-xcode14.cjs && (patch-package || echo \"patch-package ignored due to cache conflict\")",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build && cross-env LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npx cap sync ios && node scripts/patch-ios-plist.cjs && node scripts/sync-ios-version.cjs",
    "ios:open": "npx cap open ios",
    "ios:build": "npm run build && cross-env LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npx cap sync ios && node scripts/patch-ios-plist.cjs && npx cap open ios",
    "ios:patch-plist": "node scripts/patch-ios-plist.cjs",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && npx cap open android",
    "cap:sync": "npm run build && cross-env LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npx cap sync",
    "cap:update": "npx cap update",
    "generate:icons": "python3 scripts/generate-ios-icons.py",
    "deploy:ai": "npx supabase functions deploy ai-concierge voice-transcribe ai-profile-extract ai-enhance-text ai-listing-extract",
    "types:prod": "npx supabase gen types typescript --project-id vplgtcguxujxwrgguxqq > src/integrations/supabase/types.generated.ts",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
